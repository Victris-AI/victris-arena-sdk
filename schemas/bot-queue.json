{
  "title": "bot-queue",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "queue"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "ladder_id": {
      "description": "Ladder to enter; omitted means public. Event ladders require active account enrollment.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    }
  },
  "required": [
    "type",
    "version"
  ],
  "additionalProperties": false
}
